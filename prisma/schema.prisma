  NOTE
  VAULT_FILE
}

enum JobType {
  OCR
  PDF_MERGE
  PDF_SPLIT
  PDF_COMPRESS
  PDF_PROTECT
  PDF_UNLOCK
  PDF_ROTATE
  PDF_WATERMARK
  BACKUP
  NOTIFICATION_DELAY
  DATA_EXPORT
  DATA_IMPORT
  CLEANUP
}

model User {
  id                  String                @id @default(uuid()) @db.VarChar(36)
  telegramId          BigInt                @unique @map("telegram_id")
  username            String?               @db.VarChar(100)
  firstName           String                @map("first_name") @db.VarChar(150)
  lastName            String?               @map("last_name") @db.VarChar(150)
  status              UserStatus            @default(ACTIVE)
  email               String?               @unique @db.VarChar(150)
  phone               String?               @unique @db.VarChar(50)
  profilePhoto        String?               @map("profile_photo") @db.VarChar(500)
  bio                 String?               @db.Text
  country             String?               @db.VarChar(2)
  lastActive          DateTime?             @map("last_active")
  lastUsernameChange  DateTime?             @map("last_username_change")
  avatarFileId        String?               @map("avatar_file_id") @db.VarChar(36)
  avatarFile          VaultFile?            @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  lastLogin           DateTime?             @map("last_login")
  premiumPlan         PremiumPlan?          @map("premium_plan")
  premiumExpiresAt    DateTime?             @map("premium_expires_at")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  deletedAt           DateTime?             @map("deleted_at")
  createdBy           String?               @map("created_by") @db.VarChar(36)
  updatedBy           String?               @map("updated_by") @db.VarChar(36)
  deletedBy           String?               @map("deleted_by") @db.VarChar(36)
  version             Int                   @default(1)
  preferences         UserPreference?
  settings            Setting?
  todosCreated        Todo[]                @relation("TodoCreator")
  todosCompleted      Todo[]                @relation("TodoCompletedBy")
  todosArchived       Todo[]                @relation("TodoArchivedBy")
  projects            Project[]
  todoLists           TodoList[]
  labels              Label[]
  todoComments        TodoComment[]
  todoHistory         TodoHistory[]
  reminders           Reminder[]
  goals               Goal[]
  expenses            Expense[]
  loans               Loan[]
  subscriptions       Subscription[]
  splitterGroupsOwned SplitGroup[]       @relation("GroupOwner")
  splitterMembers     SplitMember[]
  vaultFolders        VaultFolder[]
  vaultFiles          VaultFile[]
  vaultUserKey        VaultUserKey?
  vaultItems          VaultItem[]
  notifications       Notification[]
  birthdays           Birthday[]
  searchIndexMetadata SearchIndexMetadata[]
  userRoles           UserRole[]
  sessions            Session[]
  notes               Note[]
  noteFolders         NoteFolder[]
  noteTags            NoteTag[]
  noteVersionEdits    NoteVersion[]         @relation("NoteVersionEditor")
  calendars           Calendar[]
  calendarEvents      CalendarEvent[]
  budgets             Budget[]
  ocrJobs             OCRJob[]
  pdfJobs             PDFJob[]
  dashboardSnapshots  DashboardSnapshot[]
  expenseCategories   ExpenseCategory[]
  financeAccounts     Account[]
  financeTransactions Transaction[]
  recurringTransactions RecurringTransaction[]
  financialGoals      FinancialGoal[]
  ledgerEntries       LedgerEntry[]

  @@map("users")
}

model UserPreference {
  id                      String          @id @default(uuid()) @db.VarChar(36)
  userId                  String          @unique @map("user_id") @db.VarChar(36)
  user                    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseCurrency            Currency        @default(USD) @map("base_currency")
  timezone                String          @default("UTC") @db.VarChar(100)
  language                Language        @default(EN)
  theme                   Theme           @default(DARK)
  dateFormat              DateFormat      @default(YYYY_MM_DD) @map("date_format")
  timeFormat              TimeFormat      @default(H24) @map("time_format")
  numberFormat            String          @default("COMMAS") @map("number_format") @db.VarChar(50)
  measurementUnits        MeasurementUnit @default(METRIC) @map("measurement_units")
  weekStartDay            WeekDay         @default(MONDAY) @map("week_start_day")
  notificationPreferences Json?           @map("notification_preferences")
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")
  deletedAt               DateTime?       @map("deleted_at")
  createdBy               String?         @map("created_by") @db.VarChar(36)
  updatedBy               String?         @map("updated_by") @db.VarChar(36)
  deletedBy               String?         @map("deleted_by") @db.VarChar(36)
  version                 Int             @default(1)

  @@map("user_preferences")
}

model Setting {
  id                  String    @id @default(uuid()) @db.VarChar(36)
  userId              String    @unique @map("user_id") @db.VarChar(36)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quietHoursStart     String?   @map("quiet_hours_start") @db.VarChar(5)
  quietHoursEnd       String?   @map("quiet_hours_end") @db.VarChar(5)
  summaryTime         String    @default("08:00") @map("summary_time") @db.VarChar(5)
  notifyEnabled       Boolean   @default(true) @map("notify_enabled")
  privacySettings     Json?     @map("privacy_settings")
  securitySettings    Json?     @map("security_settings")
  telegramPreferences Json?     @map("telegram_preferences")
  aiPreferences       Json?     @map("ai_preferences")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")
  createdBy           String?   @map("created_by") @db.VarChar(36)
  updatedBy           String?   @map("updated_by") @db.VarChar(36)
  deletedBy           String?   @map("deleted_by") @db.VarChar(36)
  version             Int       @default(1)

  @@map("settings")
}

model Todo {
  id                  String           @id @default(uuid()) @db.VarChar(36)
  userId              String           @map("user_id") @db.VarChar(36)
  user                User             @relation("TodoCreator", fields: [userId], references: [id], onDelete: Cascade)
  title               String           @db.VarChar(255)
  description         String?          @db.Text
  priority            PriorityLevel    @default(MEDIUM)
  status              TodoStatus       @default(TODO)
  
  // Relations to Project and List
  projectId           String?          @map("project_id") @db.VarChar(36)
  project             Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  listId              String?          @map("list_id") @db.VarChar(36)
  list                TodoList?        @relation(fields: [listId], references: [id], onDelete: SetNull)

  // Scheduling (Durations in minutes)
  startDate           DateTime?        @map("start_date")
  dueDate             DateTime?        @map("due_date")
  completedAt         DateTime?        @map("completed_at")
  estimatedDuration   Int?             @map("estimated_duration") // In minutes
  actualDuration      Int?             @map("actual_duration")    // In minutes
  recurrenceRule      String?          @map("recurrence_rule")    // RRULE RFC 5545 format
  
  // Self relation for parent/subtasks
  parentTodoId        String?          @map("parent_todo_id") @db.VarChar(36)
  parent              Todo?            @relation("TodoSubtasks", fields: [parentTodoId], references: [id], onDelete: Cascade)
  subtasks            Todo[]           @relation("TodoSubtasks")

  // Audit and Versioning
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  deletedAt           DateTime?        @map("deleted_at")
  createdBy           String?          @map("created_by") @db.VarChar(36)
  updatedBy           String?          @map("updated_by") @db.VarChar(36)
  deletedBy           String?          @map("deleted_by") @db.VarChar(36)
  
  // Relations for Completed and Archived
  completedById       String?          @map("completed_by_id") @db.VarChar(36)
  completedBy         User?            @relation("TodoCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  archivedById        String?          @map("archived_by_id") @db.VarChar(36)
  archivedBy          User?            @relation("TodoArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  archivedAt          DateTime?        @map("archived_at")
  version             Int              @default(1)

  // Sub-entities
  attachments         TodoAttachment[]
  comments            TodoComment[]
  checklists          Checklist[]
  labels              TodoLabel[]
  history             TodoHistory[]
  reminders           Reminder[]
  
  // Task Dependencies
  dependencies        TodoDependency[] @relation("TodoDependent")
  dependents          TodoDependency[] @relation("TodoDependency")

  @@index([userId, status], map: "idx_todos_user_status")
  @@index([userId, dueDate], map: "idx_todos_user_due")
  @@map("todos")
}

model Reminder {
  id               String            @id @default(uuid()) @db.VarChar(36)
  userId           String            @map("user_id") @db.VarChar(36)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  associatedTodoId String?           @map("associated_todo_id") @db.VarChar(36)
  todo             Todo?             @relation(fields: [associatedTodoId], references: [id], onDelete: Cascade)
  text             String            @db.VarChar(500)
  type             ReminderType      @default(CUSTOM)
  targetId         String?           @map("target_id") @db.VarChar(36)
  targetType       ReminderType?     @map("target_type")
  triggerTime      DateTime          @map("trigger_time")
  snoozeMinutes    Int               @default(0) @map("snooze_minutes")
  snoozedUntil     DateTime?         @map("snoozed_until")
  status           ReminderStatus    @default(PENDING)
  nextExecutionAt  DateTime?         @map("next_execution_at")
  lastExecutedAt   DateTime?         @map("last_executed_at")
  retryCount       Int               @default(0) @map("retry_count")
  maxRetries       Int               @default(3) @map("max_retries")
  retryStrategy    RetryStrategy     @default(FIXED) @map("retry_strategy")
  rule             ReminderRule?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")
  createdBy        String?           @map("created_by") @db.VarChar(36)
  updatedBy        String?           @map("updated_by") @db.VarChar(36)
  deletedBy        String?           @map("deleted_by") @db.VarChar(36)
  version          Int               @default(1)
  history          ReminderHistory[]

  @@index([userId, triggerTime, status], map: "idx_reminders_user_trigger_status")
  @@map("reminders")
}

model Goal {
  id         String          @id @default(uuid()) @db.VarChar(36)
  userId     String          @map("user_id") @db.VarChar(36)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String          @db.VarChar(255)
  targetDate DateTime        @map("target_date")
  progress   Int             @default(0)
  status     GoalStatus      @default(DRAFT)
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  deletedAt  DateTime?       @map("deleted_at")
  createdBy  String?         @map("created_by") @db.VarChar(36)
  updatedBy  String?         @map("updated_by") @db.VarChar(36)
  deletedBy  String?         @map("deleted_by") @db.VarChar(36)
  version    Int             @default(1)
  milestones GoalMilestone[]

  @@index([userId, status], map: "idx_goals_user_status")
  @@map("goals")
}

model GoalMilestone {
  id          String    @id @default(uuid()) @db.VarChar(36)
  goalId      String    @map("goal_id") @db.VarChar(36)
  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title       String    @db.VarChar(255)
  isCompleted Boolean   @default(false) @map("is_completed")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?   @map("created_by") @db.VarChar(36)
  updatedBy   String?   @map("updated_by") @db.VarChar(36)
  deletedBy   String?   @map("deleted_by") @db.VarChar(36)
  version     Int       @default(1)

  @@index([goalId], map: "idx_milestones_goal")
  @@map("goal_milestones")
}

enum AccountType {
  CASH
  BANK
  UPI
  CARD
  WALLET
  INVESTMENT
  CRYPTO
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  ADJUSTMENT
  REFUND
}

enum TransactionStatus {
  PENDING
  POSTED
  FAILED
  REVERSED
  CANCELLED
}

enum LoanDirection {
  BORROWED
  LENT
}

enum FinancialGoalStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

model Account {
  id                   String                 @id @default(uuid()) @db.VarChar(36)
  userId               String                 @map("user_id") @db.VarChar(36)
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String                 @db.VarChar(100)
  type                 AccountType
  currency             Currency               @default(USD)
  openingBalance       Decimal                @map("opening_balance") @db.Decimal(18, 4) @default(0.0000)
  currentBalance       Decimal                @map("current_balance") @db.Decimal(18, 4) @default(0.0000)
  availableBalance     Decimal                @map("available_balance") @db.Decimal(18, 4) @default(0.0000)
  allowNegativeBalance Boolean                @map("allow_negative_balance") @default(false)
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  deletedAt            DateTime?              @map("deleted_at")
  createdBy            String?                @map("created_by") @db.VarChar(36)
  updatedBy            String?                @map("updated_by") @db.VarChar(36)
  deletedBy            String?                @map("deleted_by") @db.VarChar(36)
  version              Int                    @default(1)

  // Relations
  transactionsSource      Transaction[] @relation("SourceAccount")
  transactionsDestination Transaction[] @relation("DestinationAccount")
  ledgerEntries           LedgerEntry[]
  financialGoals          FinancialGoal[]
  recurringSource         RecurringTransaction[] @relation("RecurSourceAccount")
  recurringDestination    RecurringTransaction[] @relation("RecurDestAccount")

  @@map("finance_accounts")
}

model Transaction {
  id            String            @id @default(uuid()) @db.VarChar(36)
  userId        String            @map("user_id") @db.VarChar(36)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          TransactionType
  status        TransactionStatus @default(POSTED)
  amount        Decimal           @db.Decimal(18, 4)
  currency      Currency          @default(USD)
  description   String            @db.VarChar(255)
  reference     String?           @db.VarChar(100)
  notes         String?           @db.Text
  transferId    String?           @map("transfer_id") @db.VarChar(36)
  
  // Exchange and base equivalents
  exchangeRate  Decimal           @map("exchange_rate") @db.Decimal(10, 6) @default(1.000000)
  baseAmount    Decimal           @map("base_amount") @db.Decimal(18, 4)

  // Categories
  categoryId    String?           @map("category_id") @db.VarChar(36)
  category      ExpenseCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Accounts
  accountId     String            @map("account_id") @db.VarChar(36)
  account       Account           @relation("SourceAccount", fields: [accountId], references: [id], onDelete: Cascade)

  // For transfers
  toAccountId   String?           @map("to_account_id") @db.VarChar(36)
  toAccount     Account?          @relation("DestinationAccount", fields: [toAccountId], references: [id], onDelete: SetNull)

  // Recurring link
  recurringId   String?           @map("recurring_id") @db.VarChar(36)
  recurring     RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  occurredAt    DateTime          @default(now()) @map("occurred_at")
  postedAt      DateTime?         @map("posted_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  deletedAt     DateTime?         @map("deleted_at")
  createdBy     String?           @map("created_by") @db.VarChar(36)
  updatedBy     String?           @map("updated_by") @db.VarChar(36)
  deletedBy     String?           @map("deleted_by") @db.VarChar(36)
  version       Int               @default(1)

  ledgerEntries LedgerEntry[]

  @@index([userId, accountId, occurredAt], map: "idx_transactions_user_account_date")
  @@map("finance_transactions")
}

model RecurringTransaction {
  id              String            @id @default(uuid()) @db.VarChar(36)
  userId          String            @map("user_id") @db.VarChar(36)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            TransactionType
  amount          Decimal           @db.Decimal(18, 4)
  currency        Currency          @default(USD)
  description     String            @db.VarChar(255)
  categoryId      String?           @map("category_id") @db.VarChar(36)
  category        ExpenseCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  accountId       String            @map("account_id") @db.VarChar(36)
  account         Account           @relation("RecurSourceAccount", fields: [accountId], references: [id], onDelete: Cascade)
  
  toAccountId     String?           @map("to_account_id") @db.VarChar(36)
  toAccount       Account?          @relation("RecurDestAccount", fields: [toAccountId], references: [id], onDelete: SetNull)
  
  // Recurrence Rule
  frequency       ReminderFrequency @default(MONTHLY)
  rrule           String?           @db.VarChar(255)
  startDate       DateTime          @map("start_date")
  endDate         DateTime?         @map("end_date")
  nextRun         DateTime?         @map("next_run")
  lastRun         DateTime?         @map("last_run")
  occurrenceCount Int               @default(0) @map("occurrence_count")
  maxOccurrences  Int?              @map("max_occurrences")

  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")
  createdBy       String?           @map("created_by") @db.VarChar(36)
  updatedBy       String?           @map("updated_by") @db.VarChar(36)
  deletedBy       String?           @map("deleted_by") @db.VarChar(36)
  version         Int               @default(1)

  transactions    Transaction[]

  @@map("recurring_transactions")
}

model LedgerEntry {
  id            String       @id @default(uuid()) @db.VarChar(36)
  userId        String       @map("user_id") @db.VarChar(36)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId     String       @map("account_id") @db.VarChar(36)
  account       Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactionId String?      @map("transaction_id") @db.VarChar(36)
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  amount        Decimal      @db.Decimal(18, 4)
  type          String       @db.VarChar(10) // "DEBIT" or "CREDIT"
  description   String       @db.VarChar(255)
  createdAt     DateTime     @default(now()) @map("created_at")

  @@map("finance_ledger_entries")
}

model FinancialGoal {
  id             String              @id @default(uuid()) @db.VarChar(36)
  userId         String              @map("user_id") @db.VarChar(36)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String              @db.VarChar(150)
  targetAmount   Decimal             @map("target_amount") @db.Decimal(18, 4)
  savedAmount    Decimal             @map("saved_amount") @db.Decimal(18, 4) @default(0.0000)
  currency       Currency            @default(USD)
  deadline       DateTime?
  status         FinancialGoalStatus @default(ACTIVE)
  
  linkedAccountId String?            @map("linked_account_id") @db.VarChar(36)
  linkedAccount   Account?           @relation(fields: [linkedAccountId], references: [id], onDelete: SetNull)

  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  deletedAt      DateTime?           @map("deleted_at")
  createdBy      String?             @map("created_by") @db.VarChar(36)
  updatedBy      String?             @map("updated_by") @db.VarChar(36)
  deletedBy      String?             @map("deleted_by") @db.VarChar(36)
  version        Int                 @default(1)

  @@map("financial_goals")
}

model ExpenseCategory {
  id                    String                 @id @default(uuid()) @db.VarChar(36)
  userId                String                 @map("user_id") @db.VarChar(36)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String                 @db.VarChar(100)
  parentId              String?                @map("parent_id") @db.VarChar(36)
  parent                ExpenseCategory?       @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subCategories         ExpenseCategory[]      @relation("CategoryHierarchy")
  sortOrder             Int                    @default(0) @map("sort_order")
  isArchived            Boolean                @default(false) @map("is_archived")
  isFavorite            Boolean                @default(false) @map("is_favorite")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  deletedAt             DateTime?              @map("deleted_at")
  createdBy             String?                @map("created_by") @db.VarChar(36)
  updatedBy             String?                @map("updated_by") @db.VarChar(36)
  deletedBy             String?                @map("deleted_by") @db.VarChar(36)
  version               Int                    @default(1)
  expenses              Expense[]
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  budgets               Budget[]
  groupExpenses         GroupExpense[]

  @@unique([userId, name])
  @@map("expense_categories")
}

model Expense {
  id          String           @id @default(uuid()) @db.VarChar(36)
  userId      String           @map("user_id") @db.VarChar(36)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Decimal          @db.Decimal(18, 4)
  currency    Currency
  description String           @db.VarChar(255)
  categoryId  String?          @map("category_id") @db.VarChar(36)
  category    ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  isRecurring Boolean          @default(false) @map("is_recurring")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")
  createdBy   String?          @map("created_by") @db.VarChar(36)
  updatedBy   String?          @map("updated_by") @db.VarChar(36)
  deletedBy   String?          @map("deleted_by") @db.VarChar(36)
  version     Int              @default(1)

  @@index([userId, categoryId, createdAt], map: "idx_expenses_user_category_date")
  @@map("expenses")
}

model Loan {
  id             String        @id @default(uuid()) @db.VarChar(36)
  userId         String        @map("user_id") @db.VarChar(36)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  principal      Decimal       @db.Decimal(18, 4)
  currency       Currency
  interestRate   Decimal       @map("interest_rate") @db.Decimal(5, 2)
  durationMonths Int           @map("duration_months")
  startDate      DateTime      @map("start_date")
  status         LoanStatus    @default(ACTIVE)
  direction      LoanDirection @default(BORROWED)
  remainingBalance Decimal     @map("remaining_balance") @db.Decimal(18, 4) @default(0.0000)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")
  createdBy      String?       @map("created_by") @db.VarChar(36)
  updatedBy      String?       @map("updated_by") @db.VarChar(36)
  deletedBy      String?       @map("deleted_by") @db.VarChar(36)
  version        Int           @default(1)
  emis           LoanEMI[]

  @@index([userId, status], map: "idx_loans_user_status")
  @@map("loans")
}

model LoanEMI {
  id                    String    @id @default(uuid()) @db.VarChar(36)
  loanId                String    @map("loan_id") @db.VarChar(36)
  loan                  Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
  amount                Decimal   @db.Decimal(18, 4)
  currency              Currency
  dueDate               DateTime  @map("due_date")
  status                EMIStatus @default(PENDING)
  installmentNumber     Int       @default(1) @map("installment_number")
  remainingInstallments Int       @default(0) @map("remaining_installments")
  paidAt                DateTime? @map("paid_at")
  lateFee               Decimal   @db.Decimal(18, 4) @default(0.0000) @map("late_fee")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")
  createdBy             String?   @map("created_by") @db.VarChar(36)
  updatedBy             String?   @map("updated_by") @db.VarChar(36)
  deletedBy             String?   @map("deleted_by") @db.VarChar(36)
  version               Int       @default(1)

  @@index([loanId, dueDate, status], map: "idx_emis_loan_due_status")
  @@map("loan_emis")
}

model Subscription {
  id          String             @id @default(uuid()) @db.VarChar(36)
  userId      String             @map("user_id") @db.VarChar(36)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String             @db.VarChar(150)
  amount      Decimal            @db.Decimal(18, 4)
  currency    Currency           @default(USD)
  cycle       String             @default("Monthly") @db.VarChar(30)
  nextBilling DateTime           @map("next_billing")
  status      SubscriptionStatus @default(ACTIVE)
  trial       Boolean            @default(false)
  autoRenew   Boolean            @default(true) @map("auto_renew")
  cancelledAt DateTime?          @map("cancelled_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  deletedAt   DateTime?          @map("deleted_at")
  createdBy   String?            @map("created_by") @db.VarChar(36)
  updatedBy   String?            @map("updated_by") @db.VarChar(36)
  deletedBy   String?            @map("deleted_by") @db.VarChar(36)
  version     Int                @default(1)

  @@index([userId, nextBilling, status], map: "idx_subs_user_billing_status")
  @@map("subscriptions")
}

model SplitGroup {
  id              String         @id @default(uuid()) @db.VarChar(36)
  ownerId         String?        @map("owner_id") @db.VarChar(36)
  owner           User?          @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  name            String         @db.VarChar(100)
  description     String?        @db.Text
  defaultCurrency Currency       @default(USD) @map("default_currency")
  icon            String?        @db.VarChar(255)
  status          GroupStatus    @default(ACTIVE)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  deletedAt       DateTime?      @map("deleted_at")
  createdBy       String?        @map("created_by") @db.VarChar(36)
  updatedBy       String?        @map("updated_by") @db.VarChar(36)
  deletedBy       String?        @map("deleted_by") @db.VarChar(36)
  version         Int            @default(1)
  
  members         SplitMember[]
  expenses        GroupExpense[]
  settlements     Settlement[]

  @@index([ownerId])
  @@map("split_groups")
}

model SplitMember {
  id          String         @id @default(uuid()) @db.VarChar(36)
  groupId     String         @map("group_id") @db.VarChar(36)
  group       SplitGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId      String?        @map("user_id") @db.VarChar(36)
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  displayName String         @map("display_name") @db.VarChar(150)
  email       String?        @db.VarChar(150)
  phone       String?        @db.VarChar(50)
  status      MemberStatus   @default(ACTIVE)
  joinedAt    DateTime       @default(now()) @map("joined_at")
  leftAt      DateTime?      @map("left_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  deletedAt   DateTime?      @map("deleted_at")
  createdBy   String?        @map("created_by") @db.VarChar(36)
  updatedBy   String?        @map("updated_by") @db.VarChar(36)
  deletedBy   String?        @map("deleted_by") @db.VarChar(36)
  version     Int            @default(1)

  payers      ExpensePayer[]
  participants ExpenseParticipant[]
  settlementsAsPayer Settlement[] @relation("SettlementPayer")
  settlementsAsReceiver Settlement[] @relation("SettlementReceiver")

  @@unique([groupId, userId])
  @@map("split_members")
}

model GroupExpense {
  id           String                @id @default(uuid()) @db.VarChar(36)
  groupId      String                @map("group_id") @db.VarChar(36)
  group        SplitGroup            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy    String                @map("created_by") @db.VarChar(36)
  description  String                @db.VarChar(255)
  currency     Currency
  totalAmount  Decimal               @map("total_amount") @db.Decimal(18, 4)
  expenseDate  DateTime              @default(now()) @map("expense_date")
  categoryId   String?               @map("category_id") @db.VarChar(36)
  category     ExpenseCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  notes        String?               @db.Text
  status       ExpenseStatus         @default(ACTIVE)
  splitType    SplitType             @default(EQUAL) @map("split_type")
  version      Int                   @default(1)
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  deletedAt    DateTime?             @map("deleted_at")
  updatedBy    String?               @map("updated_by") @db.VarChar(36)
  deletedBy    String?               @map("deleted_by") @db.VarChar(36)

  payers       ExpensePayer[]
  participants ExpenseParticipant[]
  history      GroupExpenseHistory[]

  @@index([groupId])
  @@index([expenseDate])
  @@index([status])
  @@index([createdBy])
  @@map("group_expenses")
}

model ExpensePayer {
  expenseId  String       @map("expense_id") @db.VarChar(36)
  expense    GroupExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  memberId   String       @map("member_id") @db.VarChar(36)
  member     SplitMember  @relation(fields: [memberId], references: [id], onDelete: Restrict)
  amountPaid Decimal      @map("amount_paid") @db.Decimal(18, 4)

  @@id([expenseId, memberId])
  @@map("expense_payers")
}

model ExpenseParticipant {
  expenseId  String       @map("expense_id") @db.VarChar(36)
  expense    GroupExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  memberId   String       @map("member_id") @db.VarChar(36)
  member     SplitMember  @relation(fields: [memberId], references: [id], onDelete: Restrict)
  owedAmount Decimal      @map("owed_amount") @db.Decimal(18, 4)
  percentage Decimal?     @db.Decimal(5, 2)
  shares     Decimal?     @db.Decimal(10, 2)

  @@id([expenseId, memberId])
  @@map("expense_participants")
}

model GroupExpenseHistory {
  id           String       @id @default(uuid()) @db.VarChar(36)
  expenseId    String       @map("expense_id") @db.VarChar(36)
  expense      GroupExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  version      Int
  description  String       @db.VarChar(255)
  totalAmount  Decimal      @map("total_amount") @db.Decimal(18, 4)
  currency     Currency
  splitType    SplitType    @map("split_type")
  payers       Json // serialized array of payers
  participants Json // serialized array of participants
  status       ExpenseStatus
  metadata     Json? // any other info
  changedBy    String       @map("changed_by") @db.VarChar(36)
  changedAt    DateTime     @default(now()) @map("changed_at")

  @@index([expenseId])
  @@map("group_expense_history")
}

model Settlement {
  id               String           @id @default(uuid()) @db.VarChar(36)
  groupId          String           @map("group_id") @db.VarChar(36)
  group            SplitGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payerMemberId    String           @map("payer_member_id") @db.VarChar(36)
  payerMember      SplitMember      @relation("SettlementPayer", fields: [payerMemberId], references: [id], onDelete: Restrict)
  receiverMemberId String           @map("receiver_member_id") @db.VarChar(36)
  receiverMember   SplitMember      @relation("SettlementReceiver", fields: [receiverMemberId], references: [id], onDelete: Restrict)
  amount           Decimal          @db.Decimal(18, 4)
  currency         Currency
  status           SettlementStatus @default(PENDING)
  settledAt        DateTime?        @map("settled_at")
  notes            String?          @db.Text
  idempotencyKey   String?          @unique @map("idempotency_key") @db.VarChar(64)
  syncToFinance    Boolean          @default(false) @map("sync_to_finance")
  createdBy        String           @map("created_by") @db.VarChar(36)
  version          Int              @default(1)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([groupId])
  @@index([settledAt])
  @@map("splitter_settlements")
}

model VaultFolder {
  id         String        @id @default(uuid()) @db.VarChar(36)
  userId     String        @map("user_id") @db.VarChar(36)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId   String?       @map("parent_id") @db.VarChar(36)
  parent     VaultFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subFolders VaultFolder[] @relation("FolderHierarchy")
  name       String        @db.VarChar(150)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  deletedAt  DateTime?     @map("deleted_at")
  createdBy  String?       @map("created_by") @db.VarChar(36)
  updatedBy  String?       @map("updated_by") @db.VarChar(36)
  deletedBy  String?       @map("deleted_by") @db.VarChar(36)
  version    Int           @default(1)
  files      VaultFile[]
  items      VaultItem[]

  @@index([userId, parentId], map: "idx_folders_user_parent")
  @@map("vault_folders")
}

model VaultFile {
  id                String             @id @default(uuid()) @db.VarChar(36)
  userId            String             @map("user_id") @db.VarChar(36)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId          String?            @map("folder_id") @db.VarChar(36)
  folder            VaultFolder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  name              String             @db.VarChar(255)
  storagePath       String             @map("storage_path") @db.VarChar(500)
  fileSize          BigInt             @map("file_size")
  extension         String             @db.VarChar(15)
  isFavorite        Boolean            @default(false) @map("is_favorite")
  isPinned          Boolean            @default(false) @map("is_pinned")
  checksum          String             @db.VarChar(64)
  status            FileStatus         @default(SCANNING)
  mimeType          String?            @map("mime_type") @db.VarChar(100)
  originalFilename  String?            @map("original_filename") @db.VarChar(255)
  storageProvider   StorageProvider    @default(LOCAL) @map("storage_provider")
  storageDisk       String?            @map("storage_disk") @db.VarChar(50)
  encryptionVersion String?            @map("encryption_version") @db.VarChar(20)
  contentIv         String?            @map("content_iv") @db.VarChar(64)
  contentAuthTag    String?            @map("content_auth_tag") @db.VarChar(64)
  dekVersion        Int                @default(1) @map("dek_version")
  checksumAlgorithm String?            @map("checksum_algorithm") @db.VarChar(20)
  scanResult        String?            @map("scan_result") @db.VarChar(100)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  deletedAt         DateTime?          @map("deleted_at")
  createdBy         String?            @map("created_by") @db.VarChar(36)
  updatedBy         String?            @map("updated_by") @db.VarChar(36)
  deletedBy         String?            @map("deleted_by") @db.VarChar(36)
  version           Int                @default(1)
  versions          VaultFileVersion[]
  ocrJobs           OCRJob[]           @relation("FileInput")
  pdfSourceFiles    PDFSourceFile[]    @relation("PDFSource")
  pdfOutputFiles    PDFOutputFile[]    @relation("PDFOutput")
  userAvatars       User[]             @relation("UserAvatar")
  todoAttachments   TodoAttachment[]
  noteAttachments   NoteAttachment[]
  eventAttachments  EventAttachment[]

  @@index([userId, folderId, status], map: "idx_files_user_folder_status")
  @@map("vault_files")
}

model VaultFileVersion {
  id          String    @id @default(uuid()) @db.VarChar(36)
  fileId      String    @map("file_id") @db.VarChar(36)
  file        VaultFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  version     Int       @default(1)
  storagePath String    @map("storage_path") @db.VarChar(500)
  fileSize    BigInt    @map("file_size")
  checksum    String    @db.VarChar(64)
  contentIv   String?   @map("content_iv") @db.VarChar(64)
  contentAuthTag String? @map("content_auth_tag") @db.VarChar(64)
  dekVersion  Int       @default(1) @map("dek_version")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?   @map("created_by") @db.VarChar(36)
  updatedBy   String?   @map("updated_by") @db.VarChar(36)
  deletedBy   String?   @map("deleted_by") @db.VarChar(36)
  versionVal  Int       @default(1) @map("version_val")

  @@index([fileId], map: "idx_file_versions_file")
  @@map("vault_file_versions")
}

enum VaultItemType {
  SECURE_NOTE
  CREDENTIAL
  PASSWORD
  API_KEY
  RECOVERY_CODE
  IDENTITY
  DOCUMENT
  GENERIC_SECRET
}

model VaultUserKey {
  id                String    @id @default(uuid()) @db.VarChar(36)
  userId            String    @unique @map("user_id") @db.VarChar(36)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wrappedKey        String    @map("wrapped_key") @db.Text
  wrapIv            String    @map("wrap_iv") @db.VarChar(64)
  wrapAuthTag       String    @map("wrap_auth_tag") @db.VarChar(64)
  wrappingAlgorithm String    @map("wrapping_algorithm") @db.VarChar(50)
  kekVersion        Int       @default(1) @map("kek_version")
  createdAt         DateTime  @default(now()) @map("created_at")
  rotatedAt         DateTime? @map("rotated_at")

  @@map("vault_user_keys")
}

model VaultItem {
  id                String        @id @default(uuid()) @db.VarChar(36)
  userId            String        @map("user_id") @db.VarChar(36)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId          String?       @map("folder_id") @db.VarChar(36)
  folder            VaultFolder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  type              VaultItemType
  title             String        @db.VarChar(150)
  ciphertext        String        @db.Text
  contentIv         String        @map("content_iv") @db.VarChar(64)
  contentAuthTag    String        @map("content_auth_tag") @db.VarChar(64)
  algorithm         String        @db.VarChar(20) @default("aes-256-gcm")
  encryptionVersion String        @map("encryption_version") @db.VarChar(20) @default("v1")
  dekVersion        Int           @default(1) @map("dek_version")
  isFavorite        Boolean       @default(false) @map("is_favorite")
  isPinned          Boolean       @default(false) @map("is_pinned")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")
  createdBy         String?       @map("created_by") @db.VarChar(36)
  updatedBy         String?       @map("updated_by") @db.VarChar(36)
  deletedBy         String?       @map("deleted_by") @db.VarChar(36)
  version           Int           @default(1)

  @@index([userId, folderId], map: "idx_vault_items_user_folder")
  @@map("vault_items")
}

model AuditLog {
  id            String      @id @default(uuid()) @db.VarChar(36)
  userId        String?     @map("user_id") @db.VarChar(36)
  tableName     String      @map("table_name") @db.VarChar(100)
  recordId      String      @map("record_id") @db.VarChar(36)
  action        AuditAction
  oldValue      Json?       @map("old_value")
  newValue      Json?       @map("new_value")
  correlationId String      @map("correlation_id") @db.VarChar(36)
  requestId     String?     @map("request_id") @db.VarChar(36)
  ipAddress     String?     @map("ip_address") @db.VarChar(45)
  device        String?     @db.VarChar(100)
  browser       String?     @db.VarChar(100)
  country       String?     @db.VarChar(100)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  deletedAt     DateTime?   @map("deleted_at")
  createdBy     String?     @map("created_by") @db.VarChar(36)
  updatedBy     String?     @map("updated_by") @db.VarChar(36)
  deletedBy     String?     @map("deleted_by") @db.VarChar(36)
  version       Int         @default(1)

  @@index([tableName, recordId], map: "idx_audit_table_record")
  @@index([userId, createdAt], map: "idx_audit_user_date")
  @@index([correlationId], map: "idx_audit_correlation")
  @@map("audit_logs")
}

model Notification {
  id             String              @id @default(uuid()) @db.VarChar(36)
  userId         String              @map("user_id") @db.VarChar(36)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String              @db.VarChar(250)
  body           String              @db.Text
  type           NotificationType
  status         NotificationStatus  @default(UNREAD)
  triggerTime    DateTime            @default(now()) @map("trigger_time")
  channel        NotificationChannel @default(TELEGRAM)
  priority       PriorityLevel       @default(MEDIUM)
  sentAt         DateTime?           @map("sent_at")
  readAt         DateTime?           @map("read_at")
  retryCount     Int                 @default(0) @map("retry_count")
  failedReason   String?             @map("failed_reason") @db.Text
  deliveryStatus DeliveryStatus      @default(PENDING) @map("delivery_status")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  deletedAt      DateTime?           @map("deleted_at")
  createdBy      String?             @map("created_by") @db.VarChar(36)
  updatedBy      String?             @map("updated_by") @db.VarChar(36)
  deletedBy      String?             @map("deleted_by") @db.VarChar(36)
  version        Int                 @default(1)

  @@index([userId, status, triggerTime], map: "idx_notifications_user_status_trigger")
  @@map("notifications")
}

model PluginRegistry {
  id         String       @id @default(uuid()) @db.VarChar(36)
  pluginId   String       @unique @map("plugin_id") @db.VarChar(100)
  version    String       @db.VarChar(30)
  status     PluginStatus @default(INACTIVE)
  manifest   String       @db.Text
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  deletedAt  DateTime?    @map("deleted_at")
  createdBy  String?      @map("created_by") @db.VarChar(36)
  updatedBy  String?      @map("updated_by") @db.VarChar(36)
  deletedBy  String?      @map("deleted_by") @db.VarChar(36)
  versionVal Int          @default(1) @map("version_val")

  @@map("plugin_registry")
}

model Role {
  id              String           @id @default(uuid()) @db.VarChar(36)
  name            String           @unique @db.VarChar(50)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")
  createdBy       String?          @map("created_by") @db.VarChar(36)
  updatedBy       String?          @map("updated_by") @db.VarChar(36)
