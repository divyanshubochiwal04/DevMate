model OCRPage {
  id         String      @id @default(uuid()) @db.VarChar(36)
  jobId      String      @map("job_id") @db.VarChar(36)
  job        OCRJob      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  pageNumber Int         @map("page_number")
  status     JobStatus   @default(PENDING)
  confidence Decimal?    @db.Decimal(5, 2)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  deletedAt  DateTime?   @map("deleted_at")
  createdBy  String?     @map("created_by") @db.VarChar(36)
  updatedBy  String?     @map("updated_by") @db.VarChar(36)
  deletedBy  String?     @map("deleted_by") @db.VarChar(36)
  version    Int         @default(1)
  results    OCRResult[]

  @@index([jobId, pageNumber], map: "idx_ocr_pages_job_page")
  @@map("ocr_pages")
}

model OCRResult {
  id          String    @id @default(uuid()) @db.VarChar(36)
  pageId      String    @map("page_id") @db.VarChar(36)
  page        OCRPage   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  text        String    @db.Text
  confidence  Decimal   @db.Decimal(5, 2)
  boundingBox Json?     @map("bounding_box")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?   @map("created_by") @db.VarChar(36)
  updatedBy   String?   @map("updated_by") @db.VarChar(36)
  deletedBy   String?   @map("deleted_by") @db.VarChar(36)
  version     Int       @default(1)

  @@index([pageId], map: "idx_ocr_results_page")
  @@map("ocr_results")
}

model PDFJob {
  id          String          @id @default(uuid()) @db.VarChar(36)
  userId      String          @map("user_id") @db.VarChar(36)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobType     DocumentJobType @map("job_type")
  status      JobStatus       @default(PENDING)
  errorLog    String?         @map("error_log") @db.Text
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")
  createdBy   String?         @map("created_by") @db.VarChar(36)
  updatedBy   String?         @map("updated_by") @db.VarChar(36)
  deletedBy   String?         @map("deleted_by") @db.VarChar(36)
  version     Int             @default(1)
  sourceFiles PDFSourceFile[]
  outputFiles PDFOutputFile[]

  @@index([userId, status], map: "idx_pdf_jobs_user_status")
  @@map("pdf_jobs")
}

model PDFSourceFile {
  id            String    @id @default(uuid()) @db.VarChar(36)
  jobId         String    @map("job_id") @db.VarChar(36)
  job           PDFJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fileId        String    @map("file_id") @db.VarChar(36)
  file          VaultFile @relation("PDFSource", fields: [fileId], references: [id], onDelete: Cascade)
  sequenceOrder Int       @map("sequence_order")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  createdBy     String?   @map("created_by") @db.VarChar(36)
  updatedBy     String?   @map("updated_by") @db.VarChar(36)
  deletedBy     String?   @map("deleted_by") @db.VarChar(36)
  version       Int       @default(1)

  @@index([jobId, sequenceOrder], map: "idx_pdf_source_files_job_seq")
  @@map("pdf_source_files")
}

model PDFOutputFile {
  id        String    @id @default(uuid()) @db.VarChar(36)
  jobId     String    @map("job_id") @db.VarChar(36)
  job       PDFJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fileId    String    @map("file_id") @db.VarChar(36)
  file      VaultFile @relation("PDFOutput", fields: [fileId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.VarChar(36)
  updatedBy String?   @map("updated_by") @db.VarChar(36)
  deletedBy String?   @map("deleted_by") @db.VarChar(36)
  version   Int       @default(1)

  @@index([jobId], map: "idx_pdf_output_files_job")
  @@map("pdf_output_files")
}

model DashboardSnapshot {
  id           String    @id @default(uuid()) @db.VarChar(36)
  userId       String    @map("user_id") @db.VarChar(36)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshotData Json      @map("snapshot_data")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  createdBy    String?   @map("created_by") @db.VarChar(36)
  updatedBy    String?   @map("updated_by") @db.VarChar(36)
  deletedBy    String?   @map("deleted_by") @db.VarChar(36)
  version      Int       @default(1)

  @@index([userId, createdAt])
  @@map("dashboard_snapshots")
}

model TelegramConversation {
  id           String   @id @default(uuid()) @db.VarChar(36)
  userId       BigInt   @map("user_id")
  chatId       BigInt   @map("chat_id")
  currentState String   @default("START") @map("current_state") @db.VarChar(100)
  handlerId    String?  @map("handler_id") @db.VarChar(100)
  step         Int      @default(0)
  stateData    String   @map("state_data") @db.Text
  stackData    String   @map("stack_data") @db.Text
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([userId, chatId], name: "uq_telegram_conversations_user_chat")
  @@map("telegram_conversations")
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TimeFormat {
  H12
  H24
}

enum DateFormat {
  YYYY_MM_DD
  DD_MM_YYYY
  MM_DD_YYYY
}

enum MeasurementUnit {
  METRIC
  IMPERIAL
}

model Project {
  id        String   @id @default(uuid()) @db.VarChar(36)
  name      String   @db.VarChar(255)
  userId    String   @map("user_id") @db.VarChar(36)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  todos     Todo[]

  @@unique([userId, name])
  @@map("todo_projects")
}

model TodoList {
  id        String   @id @default(uuid()) @db.VarChar(36)
  name      String   @db.VarChar(255)
  userId    String   @map("user_id") @db.VarChar(36)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  todos     Todo[]

  @@unique([userId, name])
  @@map("todo_lists")
}

model Label {
  id        String      @id @default(uuid()) @db.VarChar(36)
  name      String      @db.VarChar(100)
  userId    String      @map("user_id") @db.VarChar(36)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  color     String?     @db.VarChar(7) // Hex color code
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  todos     TodoLabel[]

  @@unique([userId, name])
  @@map("todo_labels")
}

model TodoLabel {
  todoId  String @map("todo_id") @db.VarChar(36)
  labelId String @map("label_id") @db.VarChar(36)
  todo    Todo   @relation(fields: [todoId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([todoId, labelId])
  @@map("todo_label_mappings")
}

model TodoAttachment {
  id           String    @id @default(uuid()) @db.VarChar(36)
  todoId       String    @map("todo_id") @db.VarChar(36)
  todo         Todo      @relation(fields: [todoId], references: [id], onDelete: Cascade)
  vaultFileId  String    @map("vault_file_id") @db.VarChar(36)
  vaultFile    VaultFile @relation(fields: [vaultFileId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("todo_attachments")
}

model TodoComment {
  id        String   @id @default(uuid()) @db.VarChar(36)
  todoId    String   @map("todo_id") @db.VarChar(36)
  todo      Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.VarChar(36)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("todo_comments")
}

model Checklist {
  id        String          @id @default(uuid()) @db.VarChar(36)
  todoId    String          @map("todo_id") @db.VarChar(36)
  todo      Todo            @relation(fields: [todoId], references: [id], onDelete: Cascade)
  title     String          @db.VarChar(255)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  items     ChecklistItem[]

  @@map("todo_checklists")
}

model ChecklistItem {
  id          String    @id @default(uuid()) @db.VarChar(36)
  checklistId String    @map("checklist_id") @db.VarChar(36)
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  title       String    @db.VarChar(255)
  isCompleted Boolean   @default(false) @map("is_completed")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("todo_checklist_items")
}

model TodoHistory {
  id        String   @id @default(uuid()) @db.VarChar(36)
  todoId    String   @map("todo_id") @db.VarChar(36)
  todo      Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.VarChar(36)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  field     String   @db.VarChar(100)
  oldValue  String?  @map("old_value") @db.Text
  newValue  String?  @map("new_value") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@map("todo_history")
}

model TodoDependency {
  id              String   @id @default(uuid()) @db.VarChar(36)
  todoId          String   @map("todo_id") @db.VarChar(36)
  dependsOnTodoId String   @map("depends_on_todo_id") @db.VarChar(36)
  todo            Todo     @relation("TodoDependent", fields: [todoId], references: [id], onDelete: Cascade)
  dependsOnTodo   Todo     @relation("TodoDependency", fields: [dependsOnTodoId], references: [id], onDelete: Cascade)

  @@unique([todoId, dependsOnTodoId])
  @@map("todo_dependencies")
}

model ReminderRule {
  id              String            @id @default(uuid()) @db.VarChar(36)
  reminderId      String            @unique @map("reminder_id") @db.VarChar(36)
  reminder        Reminder          @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  frequency       ReminderFrequency @default(ONETIME)
  rrule           String?           @db.VarChar(255)
  timezone        String            @default("UTC") @db.VarChar(50)
  startAt         DateTime?         @map("start_at")
  endAt           DateTime?         @map("end_at")
  occurrenceCount Int               @default(0) @map("occurrence_count")
  maxOccurrences  Int?              @map("max_occurrences")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@map("reminder_rules")
}

enum NoteType {
  PLAIN
  MARKDOWN
  CHECKLIST
  JOURNAL
  REFERENCE
  SNIPPET
}

model NoteFolder {
  id         String       @id @default(uuid()) @db.VarChar(36)
  name       String       @db.VarChar(100)
  userId     String       @map("user_id") @db.VarChar(36)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId   String?      @map("parent_id") @db.VarChar(36)
  parent     NoteFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subFolders NoteFolder[] @relation("FolderHierarchy")
  sortOrder  Int          @default(0) @map("sort_order")
  isArchived Boolean      @default(false) @map("is_archived")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  notes      Note[]

  @@unique([userId, parentId, name])
  @@map("note_folders")
}

model NoteAttachment {
  id           String    @id @default(uuid()) @db.VarChar(36)
  noteId       String    @map("note_id") @db.VarChar(36)
  note         Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  vaultFileId  String    @map("vault_file_id") @db.VarChar(36)
  vaultFile    VaultFile @relation(fields: [vaultFileId], references: [id], onDelete: Cascade)
  displayOrder Int       @default(0) @map("display_order")
  caption      String?   @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("note_attachments")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  eventId       String    @unique @map("event_id") @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(255)
  aggregateType String?   @map("aggregate_type") @db.VarChar(255)
  aggregateId   String?   @map("aggregate_id") @db.VarChar(255)
  payload       Json
  metadata      Json?
  status        String    @db.VarChar(50) // PENDING, PROCESSING, PROCESSED, RETRY, DEAD_LETTER
  attemptCount  Int       @default(0) @map("attempt_count")
  maxAttempts   Int       @default(5) @map("max_attempts")
  availableAt   DateTime  @default(now()) @map("available_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  processedAt   DateTime? @map("processed_at")
  failedAt      DateTime? @map("failed_at")
  lastError     String?   @map("last_error") @db.Text
  lockedAt      DateTime? @map("locked_at")
  lockedBy      String?   @map("locked_by") @db.VarChar(255)
  correlationId String?   @map("correlation_id") @db.VarChar(255)
  requestId     String?   @map("request_id") @db.VarChar(255)
  version       Int       @default(1)

  @@index([status, availableAt])
  @@index([status, lockedAt])
  @@index([eventType])
  @@index([aggregateType, aggregateId, createdAt])
  @@map("outbox_events")
}

model ProcessedEvent {
  id           String   @id @default(uuid()) @db.Uuid
  eventId      String   @map("event_id") @db.Uuid
  consumerName String   @map("consumer_name") @db.VarChar(255)
  processedAt  DateTime @default(now()) @map("processed_at")

  @@unique([eventId, consumerName])
  @@index([eventId])
  @@map("processed_events")
}



