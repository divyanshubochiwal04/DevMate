# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/devmate?schema=public

# Server Configuration
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Security Configuration
BCRYPT_ROUNDS=12
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Third-party Integrations
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=

# Logging Configuration
LOG_LEVEL=info

# Vault Configuration (Cryptographic keys must be valid Base64 encoded 32-byte keys)
# Note: Never commit production keys to environment files.
VAULT_MASTER_KEY=
VAULT_STORAGE_PROVIDER=LOCAL
VAULT_LOCAL_STORAGE_PATH=storage/vault
VAULT_MAX_FILE_SIZE=10485760
VAULT_ALLOWED_FILE_TYPES=*

# Outbox Configuration
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_LOCK_TIMEOUT_MS=300000
OUTBOX_BASE_RETRY_DELAY_MS=1000
OUTBOX_MAX_RETRY_DELAY_MS=60000
